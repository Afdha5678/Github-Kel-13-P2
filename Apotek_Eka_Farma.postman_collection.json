				{
					"name": "Login (Auto-Set Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.data.token);",
									"    console.log(\"Token JWT berhasil disimpan ke dalam variabel koleksi!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"owner@apotek.com\",\n    \"password\": \"owner123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
